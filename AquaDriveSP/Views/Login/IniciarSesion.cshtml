@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>AQUADRIVE SP - Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap y SweetAlert -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        /* Base */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-image: url('@Url.Content("~/images/AQUADRIVE SP.png")');
            background-repeat: no-repeat;
            background-position: center top;
            background-size: cover;
            background-attachment: scroll;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 16px;
        }

        /* Caja principal */
        .login-box {
            background-color: #13007c;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.3);
            width: 550px;
            max-width: 100%;
            min-height: 480px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
            color: white;
            overflow: auto;
            max-height: calc(100vh - 80px);
        }

        .login-box::-webkit-scrollbar {
            width: 6px;
        }
        .login-box::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
        }

        .login-box h2 {
            color: white;
            margin-bottom: 25px;
            font-size: 24px;
            font-weight: bold;
        }

        .login-box input {
            width: 70%;
            padding: 12px;
            margin-bottom: 15px;
            border: none;
            border-radius: 30px;
            outline: none;
            font-size: 14px;
            text-align: center;
        }

        /* Botones */
        .btn {
            width: 70%;
            padding: 12px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }

        .btn-login {
            background: #00cfff;
            color: white;
            margin-bottom: 10px;
        }

        .btn-login:hover {
            background: #00a3cc;
        }

        .btn-register {
            background: white;
            color: #00cfff;
            border: 2px solid #00cfff;
        }

        .btn-register:hover {
            background: #e6faff;
        }

        .forgot {
            margin-top: 15px;
        }

        .forgot a {
            color: #00cfff;
            text-decoration: none;
            font-size: 14px;
        }

        .forgot a:hover {
            text-decoration: underline;
        }

        /* === RESPONSIVE === */

        /* Tablets */
        @@media (max-width: 992px) {
            .login-box {
                width: 480px;
                padding: 32px;
                min-height: 420px;
            }

            .login-box input,
            .btn {
                width: 80%;
            }
        }

        /* Celulares */
        @@media (max-width: 576px) {
            body {
                background-position: center top;
                padding: 24px 12px;
            }

            .login-box {
                width: 100%;
                padding: 20px;
                border-radius: 12px;
                min-height: auto;
                box-shadow: 0px 3px 12px rgba(0, 0, 0, 0.25);
            }

            .login-box img {
                max-width: 140px;
                margin-bottom: 12px;
            }

            .login-box input {
                width: 100%;
                text-align: left;
                padding: 12px 14px;
                font-size: 14px;
            }

            .btn {
                width: 100%;
                font-size: 15px;
            }

            .forgot {
                margin-top: 12px;
            }
        }

        /* Pantallas grandes */
        @@media (min-width: 1400px) {
            .login-box {
                width: 640px;
                min-height: 520px;
            }
        }

    </style>
</head>
<body>
    <div class="login-box">
        <a href="/Inicio/Index" style="text-decoration: none;">
            <img src="~/images/AquaDriveSP_logo.png"
                 alt="AquaDriveSP"
                 style="max-width:180px; height:auto; margin-bottom:20px; cursor: pointer;" />
        </a>
        <form method="post" action="/Login/IniciarSesion">
            <input type="number" id="documento" name="documento" required placeholder="Documento" />
            <input type="password" id="contrasena" name="contrasena" required placeholder="Contraseña" />

            <button type="submit" class="btn btn-login">Iniciar sesión</button>
            <button type="button" onclick="location.href='/Login/Registro'" class="btn btn-register">Registrarse</button>
        </form>

        <div class="forgot">
            <a href="/Login/RecuperarContrasena">¿Olvidaste tu contraseña?</a>
        </div>
    </div>

    <!-- Modal con Spinner -->
    <div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                    <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap y scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/ScriptsViews/Login/IniciarSesion.js"></script>
</body>
</html>
