@model AquaDriveSP.Models.Usuario

@{
    ViewBag.Title = "Editar Datos Personales";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "Invitado";
}

@section Styles {
    <style>
        .editar-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0,0,0,0.3);
        }

            .editar-container h3 {
                text-align: center;
                margin-bottom: 25px;
            }

        .form-control.is-invalid {
            border-color: #dc3545;
        }
    </style>
}

<div class="editar-container">
    <h3>Editar Datos Personales</h3>

    <form id="form-editar-usuario">
        @Html.HiddenFor(m => m.usuarioid, new { id = "usuarioid" })

        <div class="mb-3">
            <label class="form-label fw-bold" for="nombre">Nombre</label>
            <input type="text" class="form-control" id="nombre" value="@Model.nombre" placeholder="Ingresa tu nombre" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" for="apellido">Apellido</label>
            <input type="text" class="form-control" id="apellido" value="@Model.apellido" placeholder="Ingresa tu apellido" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" for="email">Correo Electrónico</label>
            <input type="email" class="form-control" id="email" value="@Model.email" placeholder="ejemplo@correo.com" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" for="telefono">Teléfono</label>
            <input type="tel" class="form-control" id="telefono" value="@Model.telefono" placeholder="Número de contacto" required />
        </div>
         @if (rol == "Cliente") 
         { 
            <div class="mb-3">
                <label class="form-label fw-bold" for="direccion">Dirección</label>
                <input type="text" class="form-control" id="direccion" value="@Model.direccion" placeholder="Direccón" required />
            </div>
         }

        <div class="d-grid gap-2 mt-4">
            <button type="button" class="btn btn-success btn-lg" id="btn-guardar">
                Guardar Cambios
            </button>
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-danger btn-lg">
                Cancelar
            </a>
        </div>
    </form>
</div>
<!-- Modal con Spinner -->
<div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/ScriptsViews/Cuenta/EditarDatos.js"></script>
}
