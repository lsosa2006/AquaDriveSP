@{
    ViewBag.Title = "Estadísticas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .admin-container {
            width: 95%;
            max-width: 1800px;
            margin: 40px auto;
            padding: 20px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0,0,0,0.3);
            text-align: center;
        }

        .admin-container h2 {
            margin-bottom: 25px;
        }

        .filter-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-row input[type="date"] {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid #00cfff;
            font-size: 0.95rem;
            min-width: 150px;
        }

        .btn-blue {
            background-color: #00cfff;
            color: white;
            border: none;
            padding: 6px 18px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-blue:hover {
            background-color: #0099cc;
        }

        .charts {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
            margin: 20px 0;
        }

        .chart-box {
            flex: 1;
            min-width: 400px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* 🔹 Hace que los gráficos se ajusten sin desbordar */
        .chart-box canvas {
            width: 100% !important;
            height: auto !important;
            max-width: 100%;
        }

        .table-title {
            font-weight: bold;
            margin: 20px 0 10px 0;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table, th, td {
            border: 1px solid #ccc;
        }

        th, td {
            padding: 10px;
            text-align: center;
        }

        thead.table-light th {
            background-color: #f8f9fa;
        }

        /* =====================
           🔹 Responsividad 🔹
        ===================== */

        @@media (max-width: 992px) {
            .charts {
                flex-direction: column;
                align-items: center;
            }

            .chart-box {
                min-width: 90%;
            }
        }

        @@media (max-width: 768px) {
            .filter-row {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-row input[type="date"],
            .btn-blue {
                width: 100%;
            }

            .chart-box {
                min-width: 100%;
            }
        }

        @@media (max-width: 576px) {
            .admin-container {
                padding: 15px;
            }

            th, td {
                font-size: 0.85rem;
                padding: 8px;
            }

            .filter-row input[type="date"] {
                font-size: 0.9rem;
            }

            .btn-blue {
                font-size: 0.9rem;
                padding: 8px;
            }

            .chart-box {
                padding: 10px;
            }
        }
    </style>
}

<div class="admin-container">
    <h2>Estadísticas</h2>

    <!-- Filtros -->
    <div class="filter-row">
        <input type="date" id="fecha-inicio" />
        <input type="date" id="fecha-fin" />
        <button class="btn-blue">Buscar</button>
    </div>

    <!-- Gráficos -->
    <div class="charts">
        <div class="chart-box">
            <canvas id="chart1"></canvas>
        </div>
        <div class="chart-box">
            <canvas id="chart2"></canvas>
        </div>
    </div>

    <!-- Tabla de ingresos -->
    <div class="table-title">INGRESOS TOTALES</div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Tipo servicio</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="ingresos-table-body">
                <!-- LLenado de datos dinamico -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/ScriptsViews/Admin/Estadisticas.js"></script>
}
