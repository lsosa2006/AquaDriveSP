@{
    ViewBag.Title = "Reseñas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .resena-container {
            max-width: 1300px;
            margin: 40px auto;
            padding: 30px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0,0,0,0.3);
        }

        .resena-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0px 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 15px;
        }

        .resena-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .resena-header h5 {
                margin: 0;
            }

        .stars {
            color: gold;
            font-size: 1.2rem;
        }

        .resena-body p {
            margin-bottom: 6px;
        }

        .resena-actions {
            text-align: right;
            margin-top: 10px;
        }

        .btn-edit {
            background-color: #00cfff;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 10px;
            margin-right: 6px;
        }

        .btn-delete {
            background-color: #ff4d4d;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 10px;
        }
    </style>
}

<div class="resena-container">
    <h2 class="text-center mb-4">Historial de Reseñas</h2>
    <div id="listaResenas"></div>
</div>

<!-- Modal para editar reseña -->
<div class="modal fade" id="modalResena" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Reseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="resenaId" />

                <label>Puntuación:</label>
                <select id="puntuacion" class="form-control mb-3">
                    <option value="1">⭐</option>
                    <option value="2">⭐⭐</option>
                    <option value="3">⭐⭐⭐</option>
                    <option value="4">⭐⭐⭐⭐</option>
                    <option value="5">⭐⭐⭐⭐⭐</option>
                </select>

                <label>Comentario:</label>
                <textarea id="descripcion" class="form-control" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button id="btnGuardarResena" class="btn btn-success">Guardar cambios</button>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/ScriptsViews/Cliente/ResenasCliente.js"></script>
}
