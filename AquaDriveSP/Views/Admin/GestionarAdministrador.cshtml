@{
    ViewBag.Title = "Gestionar Administrador";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ajusta según tu layout
}

@section Styles {
    <style>
        .admin-container {
            width: 95%; /* ocupa casi todo el ancho de la pantalla */
            max-width: 1800px; /* mismo límite que empleado */
            margin: 40px auto; /* centrado */
            padding: 20px;
            background: #e6f7ff; /* mismo fondo */
            border-radius: 15px; /* bordes redondeados */
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3); /* sombra igual */
            text-align: center;
        }

            .admin-container h2 {
                text-align: center;
                margin-bottom: 20px;
            }

            .admin-container table {
                width: 100%;
                margin: 0 auto 20px auto;
                border-collapse: collapse;
                table-layout: auto; /* deja que las columnas crezcan */
            }

            .admin-container table,
            .admin-container th,
            .admin-container td {
                border: 1px solid black;
            }

            .admin-container th,
            .admin-container td {
                padding: 10px;
                text-align: center;
                word-wrap: break-word;
            }

        /* Botón crear */
        .btn-blue {
            background-color: #00cfff;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            margin-top: 10px;
        }

        /* Botón eliminar */
        .btn-red {
            background-color: #ff4d4d;
            color: white;
            border: none;
            padding: 4px 8px;
            border-radius: 5px;
            cursor: pointer;
        }

        /* Botón agregar */
        .btn-green {
            background-color: #00ff55;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        /* Input rows */
        .input-row {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 10px 0;
        }

            .input-row input {
                padding: 8px;
                border-radius: 10px;
                border: 1px solid #ccc;
                width: 180px;
            }

        #form-admin {
            display: none; /* oculto al inicio */
            flex-direction: column;
            align-items: center;
        }

            #form-admin .btn-cancel {
                background-color: #ff4d4d;
                margin-left: 10px;
            }
    </style>
}

<div class="admin-container">
    <h2>Gestionar Administrador</h2>

    <table>
        <thead>
            <tr>
                <th>Documento</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Email</th>
                <th>Telefono</th>
                <th>Contraseña</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @* Ejemplo de datos, reemplaza con tu ViewBag o Model *@
            <tr>
                <td>1013339221</td>
                <td>Juan</td>
                <td>Sosa</td>
                <td>sebastian.puerta274@pas.cuadravo.edu.co</td>
                <td>3221233424</td>
                <td>12345</td>
                <td><button class="btn-red">X</button></td>
            </tr>
            <tr>
                <td>1023628520</td>
                <td>Luis Sebastian</td>
                <td>Sosa Mejia</td>
                <td>miguelnal0706@gmail.com</td>
                <td>3226289223</td>
                <td>12345</td>
                <td><button class="btn-red">X</button></td>
            </tr>
        </tbody>
    </table>

    <button class="btn-blue" id="btn-create">Crear Administrador</button>

    <div id="form-admin">
        <div class="input-row">
            <input type="text" id="documento" placeholder="Documento">
            <input type="text" id="nombre" placeholder="Nombre">
        </div>
        <div class="input-row">
            <input type="text" id="apellido" placeholder="Apellido">
            <input type="email" id="email" placeholder="Email">
        </div>
        <div class="input-row">
            <input type="text" id="telefono" placeholder="Telefono">
            <input type="password" id="contrasena" placeholder="Contraseña">
        </div>
        <div>
            <button class="btn-green" id="btn-add">AGREGAR</button>
            <button class="btn-red btn-cancel" id="btn-cancel">CANCELAR</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const btnCreate = document.getElementById('btn-create');
        const formAdmin = document.getElementById('form-admin');
        const btnCancel = document.getElementById('btn-cancel');

        btnCreate.addEventListener('click', () => {
            formAdmin.style.display = 'flex';
            btnCreate.style.display = 'none';
        });

        btnCancel.addEventListener('click', () => {
            formAdmin.style.display = 'none';
            btnCreate.style.display = 'inline-block';

            // Limpiar campos
            document.getElementById('documento').value = '';
            document.getElementById('nombre').value = '';
            document.getElementById('apellido').value = '';
            document.getElementById('email').value = '';
            document.getElementById('telefono').value = '';
            document.getElementById('contrasena').value = '';
        });
    </script>
}