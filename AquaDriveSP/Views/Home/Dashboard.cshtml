@model AquaDriveSP.ViewModels.DashboardAdminViewModel

@{
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "Invitado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = $"Inicio {rol}";
}

@section Styles {
    <style>
        .container {
            display: flex;
            gap: 30px;
            margin: 20px auto;
            max-width: 1200px;
            align-items: stretch;
        }

        .card-left, .card-right {
            background: #e6f7ff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            font-size: 1.1rem;
            display: flex;
            flex-direction: column;
        }

        .card-left {
            flex: 1;
        }

        .card-right {
            flex: 1;
        }

        .card {
            background: #e6f7ff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            font-size: 1.1rem;
        }

            .card h3 {
                text-align: center;
                margin-bottom: 20px;
            }

        .charts {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .chart-box {
            flex: 1;
            min-width: 400px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .stars {
            color: gold;
        }

        ul {
            padding-left: 20px;
        }
    </style>
}

<div class="container">
    @if (rol == "Admin" && Model != null)
    {
        <div class="card card-left">
            <h3>Top Empleados</h3>
            <ul>
                @foreach (var e in Model.TopEmpleados)
                {
                    <li>@e</li>
                }
            </ul>

            <h3>Lavados hoy por sede</h3>
            <ul>
                @foreach (var s in Model.AutosPorSede)
                {
                    <li>@s.Key: @(s.Value) Lavados</li>
                }
            </ul>
        </div>

        <div class="card card-right">
            <h3>Estadísticas del día</h3>
            <ul>
                <li>Autos lavados hoy: @(Model.AutosPorSede.Values.Sum())</li>
                <li>Ingresos del día: $@(Model.IngresosHoy)</li>
            </ul>

            <div class="charts">
                <div class="chart-box">
                    <canvas id="ingresosChart" height="250"></canvas>
                </div>
            </div>
        </div>
    }
    else if (rol == "Empleado")
    {
        <div class="card">
            <h3>Mis tareas</h3>
            <ul>
                @foreach (var t in ViewBag.MisTareas)
                {
                    <li>@t</li>
                }
            </ul>
            <p>Horas de trabajo: @ViewBag.HorasTrabajo</p>
        </div>
    }
    else if (rol == "Cliente")
    {
        <div class="card">
            <h3>Mis Citas</h3>
            <ul>
                @foreach (var c in ViewBag.MisCitas)
                {
                    <li>@c</li>
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (rol == "Admin" && Model != null)
        {
            <text>
            var ctx = document.getElementById('ingresosChart').getContext('2d');
            var ingresosChart = new Chart(ctx, {
                type: "bar",
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DiasUltimos7Dias)),
                    datasets: [{
                        label: "Ingresos",
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.IngresosUltimos7Dias)),
                        backgroundColor: "#00cfff"
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: "Ingresos últimos 7 días",
                            color: "#333",
                            font: {
                                size: 18,
                                weight: "bold"
                            },
                            padding: { top: 10, bottom: 20 }
                        }
                    },
                    scales: {
                        x: {
                            title: { display: true, text: "Días" },
                            ticks: {
                                maxRotation: 0, // Fuerza etiquetas horizontales
                                minRotation: 0
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: "Monto ($)" },
                            ticks: {
                                callback: function (value) {
                                    return "$" + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
