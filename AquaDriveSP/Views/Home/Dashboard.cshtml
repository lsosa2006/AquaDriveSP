@model AquaDriveSP.ViewModels.DashboardAdminViewModel

@{
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "Invitado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = $"Inicio {rol}";
}

@section Styles {
    <style>
        .container {
            display: flex;
            gap: 30px;
            margin: 20px auto;
            max-width: 1200px;
            align-items: stretch; /* Esto hace que las tarjetas tengan igual altura */
        }


        .card-left, .card-right {
            background: #e6f7ff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            font-size: 1.1rem;
            display: flex;
            flex-direction: column; /* Para que el contenido se acomode verticalmente */
        }

        .card-left {
            flex: 1; /* Se ajusta proporcionalmente */
        }

        .card-right {
            flex: 1; /* Se ajusta proporcionalmente */
        }

        .card {
            background: #e6f7ff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            font-size: 1.1rem;
        }

            .card h3 {
                text-align: center;
                margin-bottom: 20px;
            }

        .stars {
            color: gold;
        }

        ul {
            padding-left: 20px;
        }

        canvas {
            margin-top: 20px;
        }
    </style>
}

<div class="container">
    @if (rol == "Admin" && Model != null)
    {
        <div class="card card-left">
            <h3>Top Empleados</h3>
            <ul>
                @foreach (var e in Model.TopEmpleados)
                {
                    <li>@e</li>
                }
            </ul>

            <h3>Lavados hoy por sede</h3>
            <ul>
                @foreach (var s in Model.AutosPorSede)
                {
                    <li>@s.Key: @(s.Value) Lavados</li>
                }
            </ul>
        </div>

        <div class="card card-right">
            <h3>Estadísticas del día</h3>
            <ul>
                <li>Autos lavados hoy: @(Model.AutosPorSede.Values.Sum())</li>
                <li>Ingresos del día: $@(Model.IngresosHoy)</li>
            </ul>

            <canvas id="ingresosChart" height="250"></canvas>
        </div>
    }
    else if (rol == "Empleado")
    {
        <div class="card">
            <h3>Mis tareas</h3>
            <ul>
                @foreach (var t in ViewBag.MisTareas)
                {
                    <li>@t</li>
                }
            </ul>
            <p>Horas de trabajo: @ViewBag.HorasTrabajo</p>
        </div>
    }
    else if (rol == "Cliente")
    {
        <div class="card">
            <h3>Mis Citas</h3>
            <ul>
                @foreach (var c in ViewBag.MisCitas)
                {
                    <li>@c</li>
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        console.log("Dashboard cargado");

        @if (rol == "Admin" && Model != null)
        {
            <text>
            var ctx = document.getElementById('ingresosChart').getContext('2d');
            var ingresosChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DiasUltimos7Dias)),
                    datasets: [{
                        label: 'Ingresos últimos 7 días',
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.IngresosUltimos7Dias)),
                        backgroundColor: '#00cfff', // Azul fluorescente
                        borderColor: '#00cfff',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
            </text>
        }
    </script>
}
