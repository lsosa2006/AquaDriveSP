@{
    Layout = null;
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "Invitado";
    var versionApp = "v1.0.0";
    var fechaActual = DateTime.Now.ToString("dd/MM/yyyy");
    var hasVehicle = Session["HasVehicle"] != null && (bool)Session["HasVehicle"];
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - AquaDriveSP</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8f9fa;
        }

        .navbar-custom {
            background-color: #13007c;
            color: white;
            padding: 10px 20px;
            position: relative;
            z-index: 1000;
        }

        .navbar-custom img {
            height: 50px;
        }

        /* ----------- MENU ----------- */
        .menu {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 15px;
            align-items: center;
            transition: all 0.3s ease-in-out;
        }

        .menu li {
            position: relative;
        }

        .menu a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            padding: 8px;
            display: inline-block;
        }

        .submenu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #0a1a8a;
            padding: 10px;
            border-radius: 5px;
            min-width: 180px;
            z-index: 1000;
        }

        .dropdown:hover .submenu {
            display: block;
        }

        /* ----------- RESPONSIVE ----------- */
        .hamburger {
            display: none;
            font-size: 1.8rem;
            color: white;
            cursor: pointer;
        }

        @@media (max-width: 992px) {
            nav {
                position: absolute;
                top: 70px;
                right: 0;
                background-color: #13007c;
                width: 100%;
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s ease-in-out;
            }

            nav.active {
                max-height: 600px;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            }

            .menu {
                flex-direction: column;
                align-items: flex-start;
                padding: 10px 20px;
                gap: 10px;
            }

            .dropdown:hover .submenu {
                display: none;
            }

            .submenu {
                position: static;
                background: rgba(0, 0, 0, 0.2);
                padding-left: 15px;
                border-radius: 0;
            }

            .dropdown.open .submenu {
                display: block;
                animation: fadeIn 0.3s ease-in;
            }

            .hamburger {
                display: block;
            }
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .main-content {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            margin: 80px auto;
            width: 100%;
            min-height: calc(100vh - 160px);
        }

        .container {
            margin: 0 auto;
            max-width: 1600px;
            width: 100%;
        }

        footer {
            background: #fff;
            color: #333;
            text-align: center;
            padding: 15px 0;
            box-shadow: 0 -2px 6px rgba(0,0,0,0.1);
            font-size: 0.9rem;
        }

        /* ----------- SWITCH ----------- */
        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }

        .switch input {
            display: none;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #ccc;
            transition: .4s;
            border-radius: 24px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background: white;
            transition: .4s;
            border-radius: 50%;
        }

        .switch input:checked + .slider {
            background: #00cfff;
        }

        .switch input:checked + .slider:before {
            transform: translateX(26px);
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="navbar-custom d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <img src="@Url.Content("~/images/AquaDriveSP_logo.png")" alt="AquaDriveSP" />
        </div>

        <i class="bi bi-list hamburger"></i>

        <nav>
            <ul class="menu m-0 p-0">
                <li><a href="@Url.Action("Dashboard", "Home")">Inicio</a></li>

                @if (rol == "Admin")
                {
                    <li><a href="@Url.Action("GestionarServicio", "Admin")">Servicios</a></li>
                    <li><a href="@Url.Action("GestionarSede", "Admin")">Sedes</a></li>
                    <li class="dropdown">
                        <a href="#">Usuarios ▾</a>
                        <ul class="submenu">
                            <li><a href="@Url.Action("GestionarEmpleado", "Admin")">Gestionar empleado</a></li>
                            <li><a href="@Url.Action("GestionarAdministrador", "Admin")">Gestionar administrador</a></li>
                        </ul>
                    </li>
                    <li><a href="@Url.Action("Estadisticas", "Admin")">Estadísticas</a></li>
                }
                @if (rol == "Empleado")
                {
                    <li><a href="@Url.Action("GestionarCitas", "Empleado")">Gestionar Citas</a></li>
                    <li><a href="@Url.Action("Horario", "Empleado")">Horario</a></li>
                    <li><a href="@Url.Action("HistorialCitas", "Empleado")">Historial de citas</a></li>
                    <li class="dropdown">
                        <a href="#">Estadísticas ▾</a>
                        <ul class="submenu">
                            <li><a href="@Url.Action("EstadisticasDesempeno", "Empleado")">Estadísticas desempeño</a></li>
                            <li><a href="@Url.Action("Resenas", "Empleado")">Reseñas</a></li>
                        </ul>
                    </li>
                }
                @if (rol == "Cliente")
                {
                    <li class="dropdown">
                        <a href="#">Citas ▾</a>
                        <ul class="submenu">
                            @if (hasVehicle)
                            {
                                <li><a href="@Url.Action("AgendarCita", "Cliente")">Agendar cita</a></li>
                                <li><a href="@Url.Action("CitasPendientes", "Cliente")">Citas pendientes</a></li>
                                <li><a href="@Url.Action("HistorialCitas", "Cliente")">Historial de citas</a></li>
                                <li><a href="@Url.Action("Resenas", "Cliente")">Reseñas realizadas</a></li>
                            }
                            else
                            {
                                <li class="text-center px-3 py-2">
                                    <small class="text-white d-block mb-2">
                                        Agrega un vehículo para usar este apartado
                                    </small>
                                    <a href="@Url.Action("GestionarVehiculos", "Cliente")"
                                       class="btn btn-sm btn-light text-primary fw-bold px-2 py-1"
                                       style="font-size: 0.8rem;">
                                        Ir a gestionar vehículos
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                    <li><a href="@Url.Action("GestionarVehiculos", "Cliente")">Gestionar vehiculos</a></li>
                }
                <li class="dropdown">
                    <a href="#">Configuración ▾</a>
                    <ul class="submenu">
                        <li><a href="@Url.Action("EditarDatos", "Cuenta")">Editar datos personales</a></li>
                        <li><a href="@Url.Action("CambiarContrasena", "Cuenta")">Cambiar contraseña</a></li>
                    </ul>
                </li>
                <li><a href="@Url.Action("CerrarSesion", "Cuenta")">Cerrar Sesión</a></li>
            </ul>
        </nav>
    </header>

    <main class="main-content">
        <div class="container">
            @RenderBody()

            <!-- Modal con Spinner -->
            <div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                        <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                            <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <span>Fecha: @fechaActual</span> | <span>Versión: @versionApp</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.all.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const spinnerModal = new bootstrap.Modal(document.getElementById('spinnerModal'), {
                backdrop: 'static', keyboard: false
            });

            document.querySelectorAll('.menu a').forEach(link => {
                link.addEventListener('click', e => {
                    const href = link.getAttribute('href');
                    if (href && href !== '#' && !href.startsWith('javascript:')) spinnerModal.show();
                });
            });

            window.addEventListener('load', () => {
                const modal = document.getElementById('spinnerModal');
                const instance = bootstrap.Modal.getInstance(modal);
                if (instance) instance.hide();
            });

            // ----- MENÚ HAMBURGUESA -----
            const hamburger = document.querySelector('.hamburger');
            const nav = document.querySelector('nav');
            const dropdowns = document.querySelectorAll('.dropdown');

            hamburger.addEventListener('click', () => {
                nav.classList.toggle('active');
                hamburger.classList.toggle('bi-x');
            });

            dropdowns.forEach(drop => {
                drop.addEventListener('click', e => {
                    e.stopPropagation();
                    dropdowns.forEach(d => {
                        if (d !== drop) d.classList.remove('open');
                    });
                    drop.classList.toggle('open');
                });
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
