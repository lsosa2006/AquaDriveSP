@{
    ViewBag.Title = "Mis Citas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .citas-container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 30px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
        }

            .citas-container h2 {
                text-align: center;
                margin-bottom: 25px;
                color: #003366;
            }

        .form-label {
            font-weight: 600;
            color: #003366;
        }

        .btn-cancelar {
            background-color: #ff4d4d;
            color: white;
            border: none;
            transition: 0.3s;
        }

            .btn-cancelar:hover {
                background-color: #e60000;
                color: white;
            }

        .search {
            border-radius: 10px;
            border: 1px solid #00cfff;
        }
    </style>
}

<div class="citas-container">
    <h2>Mis Citas Pendientes</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <input type="text" id="buscador" class="form-control search me-3 flex-grow-1" placeholder="Buscar...">
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover table-citas align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th>Placa</th>
                    <th>Fecha y Hora</th>
                    <th>Sede</th>
                    <th>Tipo de Servicio</th>
                    <th>Empleado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- Se llenará con JS -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/ScriptsViews/Cliente/CitasPendientesEmpleado.js"></script>

}