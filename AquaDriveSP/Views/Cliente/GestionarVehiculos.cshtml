@{
    ViewBag.Title = "Gestionar Vehículos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .vehiculo-container {
            max-width: 1800px;
            margin: 40px auto;
            padding: 20px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0,0,0,0.3);
        }

            .vehiculo-container h2 {
                text-align: center;
                margin-bottom: 25px;
            }

        .table-vehiculo {
            width: 100%;
        }

            .table-vehiculo th, .table-vehiculo td {
                text-align: center;
                vertical-align: middle;
            }

        .btn-blue {
            background-color: #00cfff;
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            margin-bottom: 15px;
        }

        .btn-green {
            background-color: #00ff55;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-red {
            background-color: #ff4d4d;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        #formVehiculo {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-top: 20px;
        }

        .input-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
        }

            .input-row input {
                padding: 8px;
                border-radius: 10px;
                border: 1px solid #ccc;
                width: 180px;
            }

        .form-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
        }
    </style>
}

<div class="vehiculo-container">
    <h2>Gestión de Vehículos</h2>

    <div class="text-center mb-3">
        <button id="btnNuevo" class="btn btn-blue">
            <i class="fa fa-plus"></i> Nuevo Vehículo
        </button>
    </div>

    <div class="table-responsive">
        <table id="tablaVehiculos" class="table table-bordered table-hover table-vehiculo align-middle">
            <thead class="table-light">
                <tr>
                    <th>Placa</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Color</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- Se llena dinámicamente por JS -->
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Agregar/Editar -->
<div class="modal fade" id="modalVehiculo" tabindex="-1" aria-labelledby="modalVehiculoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalVehiculoLabel">Agregar Vehículo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formVehiculo">
                    <div class="input-row">
                        <input type="text" id="txtPlaca" class="form-control" placeholder="Placa" maxlength="10" required />
                        <input type="text" id="txtMarca" class="form-control" placeholder="Marca" required />
                        <input type="text" id="txtModelo" class="form-control" placeholder="Modelo" required />
                        <input type="text" id="txtColor" class="form-control" placeholder="Color" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button id="btnGuardar" class="btn btn-success" data-accion="crear">Guardar</button>
                <button class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal con Spinner -->
<div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/ScriptsViews/GestionarVehiculos.js"></script>
}
