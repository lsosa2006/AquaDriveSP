@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>AQUADRIVE SP - Login</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: url('@Url.Content("~/images/AQUADRIVE SP.png")') no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-box {
            background-color: #13007c;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.3);
            width: 550px;
            min-height: 500px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

            .login-box h2 {
                color: white;
                margin-bottom: 30px;
            }

            .login-box input {
                width: 70%;
                padding: 12px;
                margin-bottom: 15px;
                border: none;
                border-radius: 30px;
                outline: none;
                font-size: 14px;
                text-align: center;
            }

        .btn {
            width: 70%;
            padding: 12px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }


        .btn-login {
            background: #00cfff;
            color: white;
            margin-bottom: 10px;
        }

            .btn-login:hover {
                background: #00a3cc;
            }

        .btn-register {
            background: white;
            color: #00cfff;
            border: 2px solid #00cfff;
        }

            .btn-register:hover {
                background: #e6faff;
            }

        .forgot {
            margin-top: 15px;
        }

            .forgot a {
                color: #00cfff;
                text-decoration: none;
                font-size: 14px;
            }

                .forgot a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="login-box">
        <img src="~/images/AquaDriveSP_logo.png" alt="AquaDriveSP" style="max-width:180px; height:auto; margin-bottom:20px;" />
        <form method="post" action="/Login/IniciarSesion">
            <input type="number" id="documento" name="documento" required placeholder="Documento" />

            <input type="password" id="contrasena" name="contrasena" required placeholder="Contraseña" />

            <button type="submit" class="btn btn-login">Iniciar sesión</button>
            <button type="button" onclick="location.href='/Login/Registro'" class="btn btn-register">Registrarse</button>
        </form>

        <div class="forgot">
            <a href="/Login/RecuperarContrasena">¿Olvidaste tu contraseña?</a>
        </div>
    </div>
    <!-- Modal con Spinner -->
    <div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                    <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/ScriptsViews/Login/IniciarSesion.js"></script>
</body>
</html>
