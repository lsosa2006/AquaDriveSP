@{
    Layout = null;
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "Invitado";
    var versionApp = "v1.0.0";
    var fechaActual = DateTime.Now.ToString("dd/MM/yyyy");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - AquaDriveSP</title>

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Optional: íconos -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        .main-content {
            display: flex;
            justify-content: center; /* centra horizontalmente */
            align-items: flex-start; /* puedes usar center si quieres también vertical */
            margin: 80px auto; /* margen superior e inferior */
            width: 100%;
            min-height: calc(100vh - 160px); /* asegura altura (restando navbar + footer aprox.) */
        }

        .container {
            margin: 0 auto; /* centra el contenido */
            max-width: 1600px; /* limita el ancho para que no se estire demasiado */
            width: 100%;
        }
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8f9fa;
        }

        .navbar-custom {
            background-color: #13007c;
            color: white;
            padding: 10px 20px;
        }

            .navbar-custom img {
                height: 50px;
            }

        .menu {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 15px;
            align-items: center;
        }

            .menu li {
                position: relative;
            }

            .menu a {
                color: white;
                text-decoration: none;
                font-weight: bold;
                padding: 8px;
                display: inline-block;
            }

        .submenu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #0a1a8a;
            padding: 10px;
            border-radius: 5px;
            min-width: 180px;
            z-index: 1000;
        }

        .dropdown:hover .submenu {
            display: block;
        }

        footer {
            background: #13007c;
            color: white;
            text-align: center;
            padding: 10px 0;
            position: fixed;
            bottom: 0;
            width: 100%;
        }

        /* Switch básico */
        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }

            .switch input {
                display: none;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #ccc;
            transition: .4s;
            border-radius: 24px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background: white;
                transition: .4s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background: #00cfff;
        }

            .switch input:checked + .slider:before {
                transform: translateX(26px);
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="navbar-custom d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <img src="@Url.Content("~/images/AquaDriveSP_logo.png")" alt="AquaDriveSP" />
            <div class="text-white fw-bold">AquaDriveSP</div>
        </div>

        <nav>
            <ul class="menu m-0 p-0">
                <li><a href="@Url.Action("Dashboard", "Home")">Inicio</a></li>

                @if (rol == "Admin")
                {
                    <li><a href="@Url.Action("Servicios", "Admin")">Servicios</a></li>
                    <li><a href="@Url.Action("Sedes", "Admin")">Sedes</a></li>
                    <li class="dropdown">
                        <a href="#">Usuarios ▾</a>
                        <ul class="submenu">
                            <li><a href="@Url.Action("GestionarEmpleado", "Admin")">Gestionar empleado</a></li>
                            <li><a href="@Url.Action("GestionarAdministrador", "Admin")">Gestionar administrador</a></li>
                        </ul>
                    </li>
                    <li><a href="@Url.Action("Estadisticas", "Admin")">Estadísticas</a></li>
                }

                <li class="dropdown">
                    <a href="#">Configuración ▾</a>
                    <ul class="submenu">
                        <li><a href="@Url.Action("EditarDatos", "Cuenta")">Editar datos personales</a></li>
                        <li><a href="@Url.Action("CambiarContrasena", "Cuenta")">Cambiar contraseña</a></li>
                    </ul>
                </li>

                <li><a href="@Url.Action("CerrarSesion", "Cuenta")">Cerrar Sesión</a></li>
            </ul>
        </nav>
    </header>

    <!-- Usa BOTH: tu clase principal y la clase container de Bootstrap -->
    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Bootstrap JS bundle (incluye Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    @RenderSection("Scripts", required: false)

    <footer>
        <span>Fecha: @fechaActual</span> | <span>Versión: @versionApp</span>
    </footer>
</body>
</html>