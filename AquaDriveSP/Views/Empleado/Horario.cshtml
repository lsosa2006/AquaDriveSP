@model List<AquaDriveSP.Models.Horario>

@{
    ViewBag.Title = "Horario del Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .empleado-container {
            max-width: 1600px;
            margin: 40px auto;
            padding: 30px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

            .empleado-container h2 {
                text-align: center;
                margin-bottom: 25px;
            }

        .table-responsive {
            max-height: 700px;
            overflow-y: auto;
        }
    </style>
}

<div class="empleado-container">
    <h2>Horario del Empleado</h2>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th>Día</th>
                    <th>Hora Inicio</th>
                    <th>Hora Fin</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    var diasSemana = new[] { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
                    foreach (var h in Model.OrderBy(x => x.diasemana))
                    {
                        <tr class="text-center">
                            <td>@diasSemana[h.diasemana]</td>
                            <td>@h.horainicio.ToString(@"hh\:mm")</td>
                            <td>@h.horafin.ToString(@"hh\:mm")</td>
                            <td>
                                @if (h.estado == 1)
                                {
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No hay horarios configurados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>