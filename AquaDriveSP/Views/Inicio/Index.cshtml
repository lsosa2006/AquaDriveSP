@{
    ViewBag.Title = "Inicio - AquaDriveSP";
    Layout = null;
    var iconos = new[] { "bi-car-front", "bi-droplet", "bi-lightning-charge", "bi-stars", "bi-speedometer2", "bi-gear-fill" };
    var random = new Random();
}
@model IEnumerable<AquaDriveSP.Models.TipoServicio>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            color: #333;
            overflow-x: hidden;
        }

        /* === Colores === */
        :root {
            --azul-principal: #13007c;
            --azul-claro: #00cfff;
            --gris-fondo: #f8f9fa;
        }

        /* === Navbar === */
        .navbar {
            background-color: var(--azul-principal);
        }

        .navbar-brand, .nav-link {
            color: white !important;
        }

        .nav-link:hover {
            color: var(--azul-claro) !important;
        }

        /* === Hero Section === */
        .hero {
            position: relative;
            height: 700px;
            color: white;
            text-align: center;
        }

        .hero img {
            object-fit: cover;
            width: 100%;
            height: 100%;
            filter: brightness(70%);
        }

        .hero-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
        }

        .hero h1 {
            font-weight: 700;
            font-size: 3rem;
        }

        .hero p {
            font-size: 1.2rem;
        }

        /* === Sección Experiencia === */
        .experiencia h1 {
            font-size: 5rem;
        }

        .experiencia h5 {
            margin-top: -20px;
        }

        /* === Servicios === */
        #servicios {
            background-color: var(--gris-fondo);
        }

        .service-card {
            border-radius: 20px;
            transition: all 0.3s;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

        .service-card i {
            color: var(--azul-principal);
        }

        /* === Testimonios === */
        .card-body h6 {
            color: var(--azul-principal);
        }

        /* === Formulario de contacto === */
        form .btn {
            background-color: var(--azul-principal);
            border: none;
        }

        form .btn:hover {
            background-color: var(--azul-claro);
            color: #fff;
        }

        /* === Footer === */
        footer {
            background-color: var(--azul-principal);
            color: white;
            padding: 20px 0;
            font-size: 0.9rem;
        }

        footer a {
            color: var(--azul-claro);
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        /* === Responsividad === */
        @@media (max-width: 768px) {
            .hero h1 { font-size: 2.2rem; }
            .hero p { font-size: 1rem; }
            .experiencia h1 { font-size: 3rem; }
        }

        .side-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 70%;
    height: 100%;
    background-color: var(--azul-principal);
    color: white;
    transition: all 0.4s ease;
    z-index: 9999;
    padding-top: 60px;
}

.side-menu a {
    display: block;
    color: white;
    font-size: 1.2rem;
    text-decoration: none;
    padding: 12px 0;
    transition: color 0.3s;
}

.side-menu a:hover {
    color: var(--azul-claro);
}

.side-menu.active {
    right: 0;
}

.close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 2rem;
    background: none;
    border: none;
    color: white;
}

/* Oculta el menú hamburguesa en pantallas grandes */
@@media (min-width: 992px) {
    #menuBtn {
        display: none;
    }
}

    </style>
</head>

<body>

    <!-- Franja superior -->
    <div class="bg-dark text-white text-center py-1 small">
        <i class="bi bi-lightning-charge"></i> ¡El mejor lavadero de <b>Medellín!</b>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <img src="~/images/AquaDriveSP_logo.png" alt="AquaDriveSP" height="65" class="me-2" style="width:auto;" />
            </a>

            <!-- Botón hamburguesa -->
            <button class="navbar-toggler border-0" type="button" id="menuBtn">
                <i class="bi bi-list text-white fs-1"></i>
            </button>

            <!-- Menú normal (visible solo en pantallas grandes) -->
            <div class="collapse navbar-collapse d-none d-lg-flex" id="navMenu">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="#servicios">Servicios</a></li>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="#contacto">Contacto</a></li>
                </ul>

                <a href="@Url.Action("IniciarSesion", "Login")" class="btn btn-light text-primary fw-semibold rounded-pill px-3">
                    <i class="bi bi-person-circle me-1"></i> Iniciar Sesión
                </a>
            </div>
        </div>
    </nav>

    <!-- Panel lateral del menú móvil -->
    <div id="sideMenu" class="side-menu">
        <button class="close-btn">&times;</button>
        <ul class="list-unstyled mt-5 text-center">
            <li><a href="/">Inicio</a></li>
            <li><a href="#servicios">Servicios</a></li>
            <li><a href="#contacto">Contacto</a></li>
            <li class="mt-4">
                <a href="@Url.Action("IniciarSesion", "Login")" class="btn btn-light text-primary fw-semibold rounded-pill px-4">
                    <i class="bi bi-person-circle me-1"></i> Iniciar Sesión
                </a>
            </li>
        </ul>
    </div>

    <!-- Hero -->
    <section class="hero">
        <div class="card text-bg-dark position-relative">
            <img src="~/images/Lavando.jpg" class="card-img" alt="Lavadero" style="height:700px; object-fit:fill;">
            <!-- 🔹 Capa semitransparente -->
            <div style="position:absolute; top:0; left:0; width:100%; height:100%; background-color: rgba(0, 51, 102, 0.5); z-index:1;">
            </div>
            <!-- 🔹 Texto encima -->
            <div class="card-img-overlay d-flex flex-column justify-content-center text-center" style="z-index:2;">
                <h1 class="card-title fw-bold display-4">Bienvenido a AquaDriveSP</h1>
                <p class="card-text fs-5">Lavado de autos rápido y ecológico</p>
                <a href="@Url.Action("IniciarSesion", "Login")" class="btn btn-primary btn-lg mt-3 align-self-center">Iniciar sesión</a>
            </div>
        </div>
    </section>

    <!-- Experiencia -->
    <section class="experiencia py-5 text-center">
        <div class="container">
            <h2 class="fw-bold mb-3">Experiencia AquaDriveSP</h2>
            <p class="text-muted mb-5">¡Un lavadero de autos en Medellín único para ti!</p>

            <div class="row justify-content-center mb-5">
                <div class="col-md-4 mb-3">
                    <h1 class="fw-bold text-success opacity-25">01</h1>
                    <h5 class="fw-bold">Zona de lavado eco amigable</h5>
                </div>
                <div class="col-md-4 mb-3">
                    <h1 class="fw-bold text-info opacity-25">02</h1>
                    <h5 class="fw-bold">Zona de aspirado y secado</h5>
                </div>
                <div class="col-md-4 mb-3">
                    <h1 class="fw-bold text-secondary opacity-25">03</h1>
                    <h5 class="fw-bold">Zona VIP: un lugar especial para ti</h5>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-md-6 mb-4 mb-md-0">
                    <h3 class="text-primary fw-bold">Trabajo en equipo</h3>
                    <p class="mt-3">
                        En AquaDriveSP todos los vehículos se lavan en equipo.
                        Nos inspiramos en nuestra mascota <strong>Aqua</strong>, símbolo de coordinación y esfuerzo.
                        Más manos, más cuidado y más brillo para tu vehículo.
                    </p>
                </div>
                <div class="col-md-6">
                    <img src="~/images/equipo.jpg" class="img-fluid rounded shadow" alt="Equipo AquaDriveSP">
                </div>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="py-5">
        <div class="container text-center">
            <h2 class="fw-bold mb-5 text-primary">Nuestros Servicios</h2>
            <div class="row g-4">
                @foreach (var servicio in Model)
                {
                    var icono = iconos[random.Next(iconos.Length)];
                    <div class="col-md-4 col-sm-6">
                        <div class="card service-card border-0 shadow-sm p-4 h-100">
                            <i class="bi @icono display-5 mb-3"></i>
                            <h5 class="card-title fw-bold">@servicio.nombre</h5>
                            @if (servicio.precio > 0)
                            {
                                <p class="fw-semibold text-primary mb-0">$@servicio.precio.ToString("N0")</p>
                            }
                            <p class="mt-1 text-muted">Duración: @servicio.duracionminutos minutos</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Testimonios -->
    <section class="py-5 bg-light">
        <div class="container text-center">
            <h2 class="fw-bold mb-4">Lo que dicen nuestros clientes</h2>
            <div class="row justify-content-center">
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <p class="fst-italic">“Excelente servicio, mi carro quedó como nuevo. Muy recomendados.”</p>
                            <h6 class="fw-bold mt-3">— Juan Pérez</h6>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <p class="fst-italic">“Amo que usen productos ecológicos y el tiempo de lavado fue rapidísimo.”</p>
                            <h6 class="fw-bold mt-3">— Laura Gómez</h6>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <p class="fst-italic">“El personal es muy amable y cuidadoso con el vehículo, 10/10.”</p>
                            <h6 class="fw-bold mt-3">— Andrés Castaño</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="py-5">
        <div class="container">
            <h2 class="fw-bold text-center mb-4">Contáctanos</h2>
            <p class="text-center text-muted mb-5">¿Tienes alguna duda o deseas agendar una cita? Envíanos un mensaje.</p>

            <div class="row justify-content-center">
                <div class="col-md-8">
                    <form>
                        <div class="mb-3">
                            <label for="nombre" class="form-label fw-semibold">Nombre completo</label>
                            <input type="text" class="form-control" id="nombre" placeholder="Ingresa tu nombre">
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Correo electrónico</label>
                            <input type="email" class="form-control" id="email" placeholder="ejemplo@correo.com">
                        </div>
                        <div class="mb-3">
                            <label for="mensaje" class="form-label fw-semibold">Mensaje</label>
                            <textarea class="form-control" id="mensaje" rows="4" placeholder="Escribe tu mensaje aquí..."></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary px-5">Enviar mensaje</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year AquaDriveSP — Todos los derechos reservados.</p>
            <small>Síguenos en <a href="#">Instagram</a> | <a href="#">Facebook</a> | <a href="#">X</a></small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    const menuBtn = document.getElementById('menuBtn');
    const sideMenu = document.getElementById('sideMenu');
    const closeBtn = document.querySelector('.close-btn');

    menuBtn.addEventListener('click', () => {
        sideMenu.classList.add('active');
    });

    closeBtn.addEventListener('click', () => {
        sideMenu.classList.remove('active');
    });

    // Cierra el menú si se hace clic fuera
    document.addEventListener('click', (e) => {
        if (!sideMenu.contains(e.target) && !menuBtn.contains(e.target)) {
            sideMenu.classList.remove('active');
        }
    });
    </script>

</body>
</html>
