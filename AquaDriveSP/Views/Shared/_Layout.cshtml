@{
    Layout = null;
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "Invitado";
    var versionApp = "v1.0.0";
    var fechaActual = DateTime.Now.ToString("dd/MM/yyyy");
    var hasVehicle = Session["HasVehicle"] != null && (bool)Session["HasVehicle"];
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - AquaDriveSP</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        .main-content {
            display: flex;
            justify-content: center; /* centra horizontalmente */
            align-items: flex-start; /* puedes usar center si quieres también vertical */
            margin: 80px auto; /* margen superior e inferior */
            width: 100%;
            min-height: calc(100vh - 160px); /* asegura altura (restando navbar + footer aprox.) */
        }

        .container {
            margin: 0 auto; /* centra el contenido */
            max-width: 1600px; /* limita el ancho para que no se estire demasiado */
            width: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8f9fa;
        }

        .navbar-custom {
            background-color: #13007c;
            color: white;
            padding: 10px 20px;
        }

            .navbar-custom img {
                height: 50px;
            }

        .menu {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 15px;
            align-items: center;
        }

            .menu li {
                position: relative;
            }

            .menu a {
                color: white;
                text-decoration: none;
                font-weight: bold;
                padding: 8px;
                display: inline-block;
            }

        .submenu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #0a1a8a;
            padding: 10px;
            border-radius: 5px;
            min-width: 180px;
            z-index: 1000;
        }

        .dropdown:hover .submenu {
            display: block;
        }

        main.main-content {
            flex: 1; /* ocupa todo el espacio disponible */
        }

        footer {
            background: #fff;
            color: #333;
            text-align: center;
            padding: 15px 0;
            box-shadow: 0 -2px 6px rgba(0,0,0,0.1);
            font-size: 0.9rem;
        }

        /* Switch básico */
        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }

            .switch input {
                display: none;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #ccc;
            transition: .4s;
            border-radius: 24px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background: white;
                transition: .4s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background: #00cfff;
        }

            .switch input:checked + .slider:before {
                transform: translateX(26px);
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="navbar-custom d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <img src="@Url.Content("~/images/AquaDriveSP_logo.png")" alt="AquaDriveSP" />
        </div>

        <nav>
            <ul class="menu m-0 p-0">
                <li><a href="@Url.Action("Dashboard", "Home")">Inicio</a></li>

                @if (rol == "Admin")
                {
                    <li><a href="@Url.Action("GestionarServicio", "Admin")">Servicios</a></li>
                    <li><a href="@Url.Action("GestionarSede", "Admin")">Sedes</a></li>
                    <li class="dropdown">
                        <a href="#">Usuarios ▾</a>
                        <ul class="submenu">
                            <li><a href="@Url.Action("GestionarEmpleado", "Admin")">Gestionar empleado</a></li>
                            <li><a href="@Url.Action("GestionarAdministrador", "Admin")">Gestionar administrador</a></li>
                        </ul>
                    </li>
                    <li><a href="@Url.Action("Estadisticas", "Admin")">Estadísticas</a></li>
                }
                @if (rol == "Empleado")
                {
                    <li><a href="@Url.Action("GestionarCitas", "Empleado")">Gestionar Citas</a></li>
                    <li><a href="@Url.Action("Horario", "Empleado")">Horario</a></li>
                    <li><a href="@Url.Action("HistorialCitas", "Empleado")">Historial de citas</a></li>
                    <li class="dropdown">
                        <a href="#">Estadísticas ▾</a>
                        <ul class="submenu">
                            <li><a href="@Url.Action("EstadisticasDesempeno", "Empleado")">Estadísticas desempeño</a></li>
                            <li><a href="@Url.Action("Resenas", "Empleado")">Reseñas</a></li>
                        </ul>
                    </li>
                }
                @if (rol == "Cliente")
                {
                   <li class="dropdown">
                       <a href="#">Citas ▾</a>
                       <ul class="submenu">
                           @if (hasVehicle)
                           {
                               <li><a href="@Url.Action("AgendarCita", "Cliente")">Agendar cita</a></li>
                               <li><a href="@Url.Action("CitasPendientes", "Cliente")">Citas pendientes</a></li>
                               <li><a href="@Url.Action("HistorialCitas", "Cliente")">Historial de citas</a></li>
                               <li><a href="@Url.Action("Resenas", "Cliente")">Reseñas realizadas</a></li>
                           }
                           else
                           {
                               <li class="text-center px-3 py-2">
                                   <small class="text-white d-block mb-2">
                                       Agrega un vehículo para usar este apartado
                                   </small>
                                   <a href="@Url.Action("GestionarVehiculos", "Cliente")"
                                      class="btn btn-sm btn-light text-primary fw-bold px-2 py-1"
                                      style="font-size: 0.8rem;">
                                       Ir a gestionar vehículos
                                   </a>
                               </li>
                           }
                       </ul>
                   </li>
                    <li><a href="@Url.Action("GestionarVehiculos", "Cliente")">Gestionar vehiculos</a></li>
                    @*<li><a href="@Url.Action("InfoEmpresa", "Cliente")">Información general</a></li>*@
                }
                <li class="dropdown">
                    <a href="#">Configuración ▾</a>
                    <ul class="submenu">
                        <li><a href="@Url.Action("EditarDatos", "Cuenta")">Editar datos personales</a></li>
                        <li><a href="@Url.Action("CambiarContrasena", "Cuenta")">Cambiar contraseña</a></li>
                    </ul>
                </li>

                <li><a href="@Url.Action("CerrarSesion", "Cuenta")">Cerrar Sesión</a></li>
            </ul>
        </nav>
    </header>

    <main class="main-content">
        <div class="container">
            @RenderBody()
            <!-- Modal con Spinner -->
            <div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                        <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                            <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.all.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/list.js/2.3.1/list.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.js"></script>

    @RenderSection("Scripts", required: false)

    <footer>
        <span>Fecha: @fechaActual</span> | <span>Versión: @versionApp</span>
    </footer>
</body>
</html>
