@{
    ViewBag.Title = "Recuperar contraseña";
    Layout = null; <!-- No usa el layout principal -->
}

<!DOCTYPE html>
<html lang="es">
<head>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/ScriptsViews/RecuperarContrasena.js"></script>
    <meta charset="UTF-8" />
    <title>AQUADRIVE SP - Recuperar contraseña</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: url('@Url.Content("~/images/AQUADRIVE SP.png")') no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .forgot-box {
            background-color: #0a1a8a;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.3);
            width: 350px;
            min-height: 400px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

            .forgot-box h2 {
                margin-bottom: 30px;
                font-size: 26px;
                font-weight: bold;
            }

            .forgot-box input {
                width: 80%;
                padding: 12px;
                margin-bottom: 15px;
                border: none;
                border-radius: 20px;
                outline: none;
                font-size: 14px;
                text-align: center;
            }

        .btn {
            width: 80%;
            padding: 12px;
            border: none;
            border-radius: 25px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }

        .btn-recover {
            background: #00c3ff;
            color: white;
        }

            .btn-recover:hover {
                background: #00a2d4;
            }

        .back-link {
            margin-top: 20px;
        }

            .back-link a {
                color: #00e5ff;
                text-decoration: none;
                font-size: 14px;
            }

                .back-link a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="forgot-box">
        <img src="~/images/AquaDriveSP_logo.png" alt="AquaDriveSP" style="max-width:180px; height:auto; margin-bottom:20px;" />
        <form id="formRecuperar" method="post">
            <input type="number" id="usuarioId" name="usuarioId" required placeholder="Documento" />
            <input type="email" id="correo" name="correo" required placeholder="Correo electrónico" />

            <button type="submit" class="btn btn-recover">Recuperar</button>
        </form>

        <div class="back-link">
            <a href="@Url.Action("IniciarSesion","Login")">Volver a inicio de sesión</a>
        </div>
    </div>
</body>
</html>