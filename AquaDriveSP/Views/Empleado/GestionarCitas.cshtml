@{
    ViewBag.Title = "Citas Asignadas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .empleado-container {
            max-width: 1600px;
            margin: 40px auto;
            padding: 30px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

            .empleado-container h2 {
                text-align: center;
                margin-bottom: 25px;
            }

        .table-responsive {
            max-height: 700px;
            overflow-y: auto;
        }

        .btn-manage {
            background-color: #00cfff;
            color: white;
            border: none;
        }

            .btn-manage:hover {
                background-color: #00b5e6;
                color: white;
            }
    </style>
}

<div class="empleado-container">
    <h2>Citas Asignadas del Día</h2>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th>Cliente</th>
                    <th>Vehículo</th>
                    <th>Servicio</th>
                    <th>Sede</th>
                    <th>Hora Inicio</th>
                    <th>Hora Fin</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
        </table>
    </div>
</div>

<!-- Modal Gestionar Cita -->
<div class="modal fade" id="modalGestionar" tabindex="-1" aria-labelledby="modalGestionarLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalGestionarLabel">Gestionar Cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/ScriptsViews/GestionarCitas.js"></script>
}