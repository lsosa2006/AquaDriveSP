@model AquaDriveSP.Models.Usuario

@{
    ViewBag.Title = "Editar Datos Personales";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "Invitado";
}

@section Styles {
    <style>
        .editar-container {
            max-width: 600px;
            margin: 60px auto;
            padding: 40px 30px;
            background: #f0faff;
            border-radius: 18px;
            box-shadow: 0px 6px 25px rgba(0, 173, 239, 0.25);
            transition: all 0.3s ease-in-out;
        }

        .editar-container:hover {
            box-shadow: 0px 8px 30px rgba(0, 173, 239, 0.35);
        }

        .editar-container h3 {
            font-weight: 700;
            color: #0077b6;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #023e8a;
        }

        .form-control {
            border-radius: 12px;
            border: 1px solid #bde0fe;
            padding: 10px 12px;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .form-control:focus {
            border-color: #00b4d8;
            box-shadow: 0 0 6px rgba(0, 180, 216, 0.4);
            outline: none;
        }

        .btn-success {
            background: linear-gradient(135deg, #00b4d8, #0077b6);
            border: none;
            color: white;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s;
        }

        .btn-success:hover {
            background: linear-gradient(135deg, #0096c7, #023e8a);
            transform: translateY(-2px);
        }

        .btn-danger {
            background-color: #d9534f;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-danger:hover {
            background-color: #c9302c;
            transform: translateY(-2px);
        }

        /* Espaciado entre campos */
        .mb-3 {
            margin-bottom: 18px !important;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .editar-container {
                margin: 30px 15px;
                padding: 25px;
            }

            h3 {
                font-size: 1.4rem;
            }

            .btn-success, .btn-danger {
                font-size: 1rem;
                padding: 10px;
            }

            .form-control {
                font-size: 0.95rem;
            }
        }
    </style>
}

<div class="editar-container">
    <h3>Editar Datos Personales</h3>

    <form id="form-editar-usuario">
        @Html.HiddenFor(m => m.usuarioid, new { id = "usuarioid" })

        <div class="mb-3">
            <label class="form-label" for="nombre">Nombre</label>
            <input type="text" class="form-control" id="nombre" value="@Model.nombre" placeholder="Ingresa tu nombre" required />
        </div>

        <div class="mb-3">
            <label class="form-label" for="apellido">Apellido</label>
            <input type="text" class="form-control" id="apellido" value="@Model.apellido" placeholder="Ingresa tu apellido" required />
        </div>

        <div class="mb-3">
            <label class="form-label" for="email">Correo Electrónico</label>
            <input type="email" class="form-control" id="email" value="@Model.email" placeholder="ejemplo@correo.com" required />
        </div>

        <div class="mb-3">
            <label class="form-label" for="telefono">Teléfono</label>
            <input type="tel" class="form-control" id="telefono" value="@Model.telefono" placeholder="Número de contacto" required />
        </div>

        @if (rol == "Cliente")
        {
            <div class="mb-3">
                <label class="form-label" for="direccion">Dirección</label>
                <input type="text" class="form-control" id="direccion" value="@Model.direccion" placeholder="Dirección" required />
            </div>
        }

        <div class="d-grid gap-2 mt-4">
            <button type="button" class="btn btn-success btn-lg" id="btn-guardar">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

<!-- Modal con Spinner -->
<div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/ScriptsViews/Cuenta/EditarDatos.js"></script>
}