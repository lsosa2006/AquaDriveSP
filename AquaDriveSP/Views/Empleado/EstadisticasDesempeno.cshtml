@{
    ViewBag.Title = "Desempeño del Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .admin-container {
            width: 95%;
            max-width: 1800px;
            margin: 40px auto;
            padding: 20px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0,0,0,0.3);
            text-align: center;
        }

            .admin-container h2 {
                margin-bottom: 25px;
            }

        .filter-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

            .filter-row input[type="date"] {
                padding: 6px 12px;
                border-radius: 8px;
                border: 1px solid #00cfff;
                font-size: 0.95rem;
            }

        .btn-blue {
            background-color: #00cfff;
            color: white;
            border: none;
            padding: 6px 18px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-blue:hover {
                background-color: #0099cc;
            }

        .charts {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
            margin: 20px 0;
        }

        .chart-box {
            flex: 1;
            min-width: 400px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            height: 500px;
            justify-content:center;
        }

        #chartServicios {
            margin-left:80px;
            align-items:center;
        }


        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 0px;
            margin: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            display: inline-block;
            width: 240px;
            text-align: center;
        }

            .stat-card h3 {
                color: #0099cc;
                margin-bottom: 10px;
                margin-top:10px;
            }

            .stat-card p {
                font-size: 1.3rem;
                font-weight: bold;
                color: #333;
            }
    </style>
}

<div class="admin-container">
    <h2><b>Desempeño del Empleado</b></h2>

    <!-- Filtros -->
    <div class="filter-row">
        <input type="date" id="fecha-inicio" />
        <input type="date" id="fecha-fin" />
        <button class="btn-blue" id="btnfiltrar">Buscar</button>
    </div>

    <!-- Tarjetas resumen -->
    <div class="stats">
        <div class="stat-card">
            <h3>📅 Citas Atendidas</h3>
            <p id="total-citas">--</p>
        </div>
    </div>

    <!-- Gráficos -->
    <div class="charts">
        <div class="chart-box">
            <canvas id="chartCitas"></canvas>
        </div>
        <div class="chart-box">
            <canvas id="chartServicios"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/ScriptsViews/EstadisticasDesempeno.js"></script>
}
