@{
    ViewBag.Title = "Registrarse";
    Layout = null; <!-- No usa el layout principal -->
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>AQUADRIVE SP - Registro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: url('@Url.Content("~/images/AQUADRIVE SP.png")') no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .registro-box {
            background-color: #13007c; /* mismo color de login */
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0px 3px 15px rgba(0, 0, 0, 0.3);
            width: 450px; /* más angosto */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .registro-box h2 {
            margin-bottom: 20px;
            font-size: 24px;
            font-weight: bold;
        }

        .registro-box input {
            width: 70%;
            padding: 8px;
            margin-bottom: 10px;
            border: none;
            border-radius: 25px;
            outline: none;
            font-size: 14px;
            text-align: center;
        }

        .tipo-cuenta {
            margin: 15px 0;
            text-align: center;
        }

        .radio-options {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 5px;
        }

        .radio-options label {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
            font-weight: normal;
        }

        .btn {
            width: 75%;
            padding: 10px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }

        .btn-register {
            background: #00cfff;
            color: white;
        }

        .btn-register:hover {
            background: #00a3cc;
        }

        .login-link {
            margin-top: 10px;
        }

        .login-link a {
            color: #00cfff;
            text-decoration: none;
            font-size: 14px;
        }

        .login-link a:hover {
            text-decoration: underline;
        }
        .texto-opcional {
            display: block;
            color: #b30000; /* rojo suave */
            font-size: 11px; /* pequeño */
            margin-top: -10px; /* más cerca del input */
            margin-bottom: 10px; /* mantiene espacio con el siguiente campo */
            text-align: left;
            width: 70%;
            padding: 8px;
            text-align: center;
            outline: none;
        }
    </style>
</head>
<body>
    <div class="registro-box">
        <img src="~/images/AquaDriveSP_logo.png" alt="AquaDriveSP" style="max-width:150px; height:auto; margin-bottom:15px;" />
        <form method="post" action="@Url.Action("Registro","Login")">
            <input type="number" id="usuarioId" name="usuarioId" required placeholder="Documento" />
            <input type="text" id="nombre" name="nombre" required placeholder="Nombre" />
            <input type="text" id="apellido" name="apellido" required placeholder="Apellido" />
            <input type="email" id="correo" name="correo" required placeholder="Correo electrónico" />
            <input type="text" id="telefono" name="telefono" required placeholder="Teléfono" />
            <input type="password" id="contrasena" name="contrasena" required placeholder="Contraseña" />
            <input type="text" id="direccion" name="direccion" placeholder="Direccion" />
            <small class="texto-opcional">* Opcional para empleados</small>

            <div class="tipo-cuenta">
                <span>Tipo de cuenta</span>
                <div class="radio-options">
                    <label for="cliente">
                        <input type="radio" id="cliente" name="tipoCuenta" value="cliente" required />
                        Cliente
                    </label>
                    <label for="empleado">
                        <input type="radio" id="empleado" name="tipoCuenta" value="empleado" required />
                        Empleado
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-register">Registrarse</button>
        </form>

        <div class="login-link">
            <a href="@Url.Action("IniciarSesion","Login")">¿Ya tienes cuenta? Inicia sesión</a>
        </div>
    </div>

    <!-- Modal con Spinner -->
    <div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                    <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/ScriptsViews/Login/Registro.js"></script>
</body>
</html>
