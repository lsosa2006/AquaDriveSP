@{
    ViewBag.Title = "Registrarse";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>AQUADRIVE SP - Registro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        /* --------- Reset básico y box sizing --------- */
        *, *::before, *::after { box-sizing: border-box; }

        /* --------- Fondo y comportamiento responsivo --------- */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            /* Mantengo la misma imagen, pero sin attachment fixed */
            background-image: url('@Url.Content("~/images/AQUADRIVE SP.png")');
            background-repeat: no-repeat;
            background-position: center top;
            background-size: cover;
            background-attachment: scroll;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 16px; /* evita que la caja llegue al borde en móviles */
            overflow-x: hidden;
        }

        /* --------- Caja de registro (no fixed para ser responsive) --------- */
        .registro-box {
            background-color: #13007c; /* mismo color de login */
            padding: 24px;
            border-radius: 15px;
            box-shadow: 0px 3px 15px rgba(0, 0, 0, 0.3);
            width: 450px; /* ancho base de escritorio */
            max-width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            position: relative; /* ya no es fixed */
            /* permite scroll interno si la caja queda grande en vistas pequeñas */
            max-height: calc(100vh - 80px);
            overflow: auto;
        }

        .registro-box::-webkit-scrollbar { height: 6px; width: 6px; }
        .registro-box::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 10px; }

        .registro-box h2 {
            margin-bottom: 16px;
            font-size: 24px;
            font-weight: bold;
        }

        /* Inputs: mantengo la apariencia centrada pero permito que ocupen más espacio en pantallas pequeñas */
        .registro-box input {
            width: 70%;
            padding: 10px 12px;
            margin-bottom: 10px;
            border: none;
            border-radius: 25px;
            outline: none;
            font-size: 14px;
            text-align: center;
            color: #111;
        }

        /* placeholder color to be legible on white inputs */
        .registro-box input::placeholder { color: #777; }

        .tipo-cuenta {
            margin: 12px 0 6px;
            text-align: center;
        }

        .radio-options {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 5px;
            flex-wrap: wrap;
        }

        .radio-options label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: normal;
            color: white;
        }

        .btn {
            width: 75%;
            padding: 10px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }

        .btn-register {
            background: #00cfff;
            color: white;
        }

        .btn-register:hover {
            background: #00a3cc;
        }

        .login-link {
            margin-top: 10px;
        }

        .login-link a {
            color: #00cfff;
            text-decoration: none;
            font-size: 14px;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        .texto-opcional {
            display: block;
            color: #b30000;
            font-size: 11px;
            margin-top: -10px;
            margin-bottom: 10px;
            text-align: center;
            width: 70%;
            padding: 8px;
            outline: none;
        }

        /* --------- Responsividad específica --------- */

        /* Tablets y pantallas medianas */
        @@media (max-width: 992px) {
            .registro-box { width: 420px; padding: 22px; }
            .registro-box input { width: 80%; font-size: 15px; padding: 10px; }
            .btn { width: 80%; }
            .texto-opcional { width: 80%; }
        }

        /* Smartphones (ajustes principales) */
        @@media (max-width: 576px) {
            /* Ajusta la posición del fondo para que no interfiera con la caja */
            body {
                background-position: center top;
                padding: 30px 12px;
            }

            .registro-box {
                width: 100%;
                padding: 18px;
                border-radius: 12px;
                max-height: none; /* permite que la caja crezca con el contenido */
            }

            /* Inputs ocupan 100% pero manteniendo el estilo centrado */
            .registro-box input {
                width: 100%;
                text-align: left; /* más natural en móvil */
                padding: 12px 14px;
                font-size: 14px;
            }

            .registro-box img { max-width: 130px; height: auto; margin-bottom: 12px; }

            .radio-options { flex-direction: column; gap: 8px; align-items: center; }

            .btn {
                width: 100%;
                padding: 11px;
                font-size: 15px;
            }

            .texto-opcional {
                width: 100%;
                font-size: 11px;
                margin-top: 6px;
                margin-bottom: 12px;
                text-align: center;
            }

            /* Reduce sombras para que la app se vea ligera en móviles */
            .registro-box { box-shadow: 0px 2px 10px rgba(0,0,0,0.18); }
        }

        /* Muy grandes pantallas: mantiene proporción */
        @@media (min-width: 1400px) {
            .registro-box { width: 520px; }
            .registro-box input { width: 75%; }
            .btn { width: 75%; }
        }
    </style>
</head>
<body>
    <div class="registro-box">
        <img src="~/images/AquaDriveSP_logo.png" alt="AquaDriveSP" style="max-width:150px; height:auto; margin-bottom:15px;" />
        <form method="post" action="@Url.Action("Registro","Login")">
            <input type="number" id="usuarioId" name="usuarioId" required placeholder="Documento" />
            <input type="text" id="nombre" name="nombre" required placeholder="Nombre" />
            <input type="text" id="apellido" name="apellido" required placeholder="Apellido" />
            <input type="email" id="correo" name="correo" required placeholder="Correo electrónico" />
            <input type="text" id="telefono" name="telefono" required placeholder="Teléfono" />
            <input type="password" id="contrasena" name="contrasena" required placeholder="Contraseña" />
            <input type="text" id="direccion" name="direccion" placeholder="Direccion" />
            <small class="texto-opcional">* Opcional para empleados</small>

            <div class="tipo-cuenta">
                <span>Tipo de cuenta</span>
                <div class="radio-options">
                    <label for="cliente">
                        <input type="radio" id="cliente" name="tipoCuenta" value="cliente" required />
                        Cliente
                    </label>
                    <label for="empleado">
                        <input type="radio" id="empleado" name="tipoCuenta" value="empleado" required />
                        Empleado
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-register">Registrarse</button>
        </form>

        <div class="login-link">
            <a href="@Url.Action("IniciarSesion","Login")">¿Ya tienes cuenta? Inicia sesión</a>
        </div>
    </div>

    <!-- Modal con Spinner -->
    <div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                    <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/ScriptsViews/Login/Registro.js"></script>
</body>
</html>
