@{
    ViewBag.Title = "Estadísticas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .admin-container {
            width: 95%;
            max-width: 1800px;
            margin: 40px auto;
            padding: 20px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

            .admin-container h2 {
                margin-bottom: 20px;
            }

        .filter-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

            .filter-row input[type="date"] {
                padding: 6px 12px;
                border-radius: 8px;
                border: 1px solid #00cfff;
                font-size: 0.95rem;
            }

        .btn-blue {
            background-color: #00cfff;
            color: white;
            border: none;
            padding: 6px 18px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-blue:hover {
                background-color: #0099cc;
            }

        .charts {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
            margin: 20px 0;
        }

        .chart-box {
            flex: 1;
            min-width: 400px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .admin-container table {
            width: 100%;
            margin: 20px auto;
            border-collapse: collapse;
            table-layout: auto;
        }

        .admin-container table,
        .admin-container th,
        .admin-container td {
            border: 1px solid black;
        }

        .admin-container th,
        .admin-container td {
            padding: 10px;
            text-align: center;
        }

        .table-title {
            font-weight: bold;
            margin: 20px 0 10px 0;
        }
    </style>
}

<div class="admin-container">
    <h2>Estadísticas</h2>

    <!-- Filtros -->
    <div class="filter-row">
        <input type="date" id="fecha-inicio" />
        <input type="date" id="fecha-fin" />
        <button class="btn-blue">Buscar</button>
    </div>

    <!-- Gráficos -->
    <div class="charts">
        <div class="chart-box">
            <canvas id="chart1"></canvas>
        </div>
        <div class="chart-box">
            <canvas id="chart2"></canvas>
        </div>
    </div>

    <!-- Tabla -->
    <div class="table-title">INGRESOS TOTALES</div>

    <table>
        <thead>
            <tr>
                <th>Tipo servicio</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Lavado Básico</td>
                <td>30.000</td>
                <td>125</td>
                <td>3.750.000</td>
            </tr>
            <tr>
                <td>Lavado Premium</td>
                <td>50.000</td>
                <td>108</td>
                <td>5.400.000</td>
            </tr>
            <tr>
                <td>Lavado Detallado</td>
                <td>70.000</td>
                <td>86</td>
                <td>6.020.000</td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Gráfico 1 (ejemplo quemado)
        new Chart(document.getElementById("chart1"), {
            type: 'bar',
            data: {
                labels: ["Lunes", "Martes", "Miércoles"],
                datasets: [{
                    label: "Servicios por día",
                    data: [10, 20, 30],
                    backgroundColor: '#00cfff'
                }]
            }
        });

        // Gráfico 2 (ejemplo quemado)
        new Chart(document.getElementById("chart2"), {
            type: 'bar',
            data: {
                labels: ["Enero", "Febrero", "Marzo"],
                datasets: [{
                    label: "Ingresos por mes",
                    data: [1000, 2000, 3000],
                    backgroundColor: '#00cfff'
                }]
            }
        });
    </script>
}
