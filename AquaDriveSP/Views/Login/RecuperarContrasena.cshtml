@{
    ViewBag.Title = "Recuperar contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>AQUADRIVE SP - Recuperar contraseña</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        /* Reset box-sizing */
        *, *::before, *::after { box-sizing: border-box; }

        /* Fondo y comportamiento responsivo */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-image: url('@Url.Content("~/images/AQUADRIVE SP.png")');
            background-repeat: no-repeat;
            background-position: center top;
            background-size: cover;
            background-attachment: scroll;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 16px; /* espacio en móviles */
            overflow-x: hidden;
        }

        /* Caja central (no fixed para ser responsive) */
        .recover-box {
            background-color: #13007c; /* mismo color que login-box */
            padding: 36px;
            border-radius: 20px;
            box-shadow: 0px 6px 24px rgba(0, 0, 0, 0.28);
            width: 550px; /* ancho base de escritorio */
            max-width: 100%;
            min-height: 420px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative; /* ya no es fixed */
            color: white;
            overflow: auto;
            max-height: calc(100vh - 80px);
        }

        .recover-box::-webkit-scrollbar { width: 6px; height: 6px; }
        .recover-box::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 8px; }

        .recover-box h2 {
            color: white;
            margin-bottom: 22px;
            font-size: 24px;
            font-weight: 700;
        }

        .recover-box input {
            width: 70%;
            padding: 12px 14px;
            margin-bottom: 14px;
            border: none;
            border-radius: 30px;
            outline: none;
            font-size: 14px;
            text-align: center;
            color: #111;
        }

        .recover-box input::placeholder { color: #777; }

        .btn {
            width: 70%;
            padding: 12px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.25s;
            margin-top: 10px;
        }

        .btn-recover {
            background: #00cfff;
            color: white;
        }

        .btn-recover:hover {
            background: #00a3cc;
        }

        .back-link {
            margin-top: 18px;
        }

        .back-link a {
            color: #00cfff;
            text-decoration: none;
            font-size: 14px;
        }

        .back-link a:hover {
            text-decoration: underline;
        }

        /* ===== Responsividad ===== */

        /* Pantallas medianas (tablets) */
        @@media (max-width: 992px) {
            .recover-box {
                width: 480px;
                padding: 30px;
                min-height: 380px;
            }
            .recover-box input { width: 80%; }
            .btn { width: 80%; }
        }

        /* Smartphones */
        @@media (max-width: 576px) {
            /* Ajusta fondo para móviles */
            body {
                background-position: center top;
                padding: 24px 12px;
            }

            .recover-box {
                width: 100%;
                padding: 20px;
                border-radius: 12px;
                min-height: auto;
                max-height: none;
                box-shadow: 0px 3px 12px rgba(0,0,0,0.18);
            }

            .recover-box h2 {
                font-size: 20px;
                margin-bottom: 14px;
            }

            .recover-box img {
                max-width: 140px;
                margin-bottom: 12px;
            }

            .recover-box input {
                width: 100%;
                text-align: left;
                padding: 12px 14px;
                font-size: 14px;
            }

            .btn {
                width: 100%;
                padding: 12px;
                font-size: 15px;
            }

            .back-link { margin-top: 14px; }
        }

        /* Pantallas muy grandes: mantiene proporción */
       @@media (min-width: 1400px) {
            .recover-box { width: 640px; min-height: 480px; }
            .recover-box input { width: 70%; }
            .btn { width: 70%; }
        }

    </style>
</head>
<body>
    <div class="recover-box">
        <img src="~/images/AquaDriveSP_logo.png" alt="AquaDriveSP" style="max-width:180px; height:auto; margin-bottom:20px;" />
        <form id="formRecuperar" method="post">
            <input type="number" id="usuarioId" name="usuarioId" required placeholder="Documento" />
            <input type="email" id="correo" name="correo" required placeholder="Correo electrónico" />
            <button type="submit" class="btn btn-recover">Recuperar</button>
        </form>

        <div class="back-link">
            <a href="@Url.Action("IniciarSesion","Login")">Volver a inicio de sesión</a>
        </div>
    </div>

    <!-- Modal con Spinner -->
    <div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                    <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/ScriptsViews/Login/RecuperarContrasena.js"></script>
</body>
</html>
