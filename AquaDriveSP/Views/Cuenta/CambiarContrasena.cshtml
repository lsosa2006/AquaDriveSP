@model AquaDriveSP.Models.Usuario

@{
    ViewBag.Title = "Cambiar Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .contrasena-container {
            max-width: 450px;
            margin: 60px auto;
            padding: 40px 30px;
            background: #f0faff;
            border-radius: 18px;
            box-shadow: 0px 6px 25px rgba(0, 173, 239, 0.25);
            text-align: center;
            transition: all 0.3s ease-in-out;
        }

        .contrasena-container:hover {
            box-shadow: 0px 8px 30px rgba(0, 173, 239, 0.35);
        }

        .contrasena-container h3 {
            font-weight: 700;
            color: #0077b6;
            margin-bottom: 25px;
        }

        #form-cambiar-contrasena {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        #form-cambiar-contrasena input {
            padding: 12px;
            border-radius: 12px;
            border: 1px solid #bde0fe;
            transition: border-color 0.3s;
        }

        #form-cambiar-contrasena input:focus {
            outline: none;
            border-color: #00b4d8;
            box-shadow: 0 0 5px rgba(0, 180, 216, 0.4);
        }

        .btn-guardar {
            background: linear-gradient(135deg, #00b4d8, #0077b6);
            color: #fff;
            font-weight: 600;
            padding: 12px;
            border: none;
            border-radius: 12px;
            width: 100%;
            font-size: 1.1rem;
            transition: all 0.3s;
        }

        .btn-guardar:hover {
            background: linear-gradient(135deg, #0096c7, #023e8a);
            transform: translateY(-2px);
        }

        /* Responsivo */
        @@media (max-width: 576px) {
            .contrasena-container {
                margin: 30px 15px;
                padding: 25px;
            }

            .btn-guardar {
                font-size: 1rem;
                padding: 10px;
            }

            #form-cambiar-contrasena input {
                padding: 10px;
                font-size: 0.95rem;
            }
        }
    </style>
}

<div class="contrasena-container">
    <h3>Cambiar Contraseña</h3>

    <form id="form-cambiar-contrasena">
        @Html.HiddenFor(m => m.usuarioid)

        <input type="password" id="contrasenaActual" name="contrasenaActual" placeholder="Contraseña Actual" required />
        <input type="password" id="nuevaContrasena" name="nuevaContrasena" placeholder="Nueva Contraseña" required />
        <input type="password" id="confirmarContrasena" name="confirmarContrasena" placeholder="Confirmar Nueva Contraseña" required />

        <button type="submit" class="btn-guardar">Guardar Cambios</button>
    </form>
</div>

<!-- Modal con Spinner -->
<div class="modal fade" id="spinnerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <div class="d-flex justify-content-center align-items-center" style="height: 150px;">
                <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/ScriptsViews/Cuenta/CambiarContrasena.js"></script>
}
