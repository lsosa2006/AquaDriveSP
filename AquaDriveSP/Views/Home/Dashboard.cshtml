
@model AquaDriveSP.ViewModels.DashboardViewModel
@{
    var distanciaFormateada = Model.ClienteData?.DistanciaSedeKm != null
    ? Model.ClienteData.DistanciaSedeKm.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
    : "N/A";
    var hasVehicle = Session["HasVehicle"] != null && (bool)Session["HasVehicle"];
}


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = $"Inicio {Model.Rol}";
}

@section Styles {
    <style>
        .container {
            display: flex;
            gap: 30px;
            margin: 20px auto;
            max-width: 1200px;
        }

        .card-left {
            flex: 0 0 380px;
            background: #e6f7ff;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            font-size: 1.05rem;
            display: flex;
            flex-direction: column;
            overflow-wrap: break-word;
        }

        .card-right {
            flex: 1;
            background: #e6f7ff;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
            font-size: 1.1rem;
            display: flex;
            flex-direction: column;
        }

        .card h3 {
            text-align: center;
            margin-bottom: 15px;
            word-break: break-word;
        }

        ul {
            padding-left: 20px;
            margin-bottom: 15px;
            word-break: break-word;
        }

        .charts {
            display: flex;
            justify-content: center;
            align-items: stretch;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 15px;
        }

        .chart-box {
            flex: 1;
            min-width: 300px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .stars {
            color: gold;
        }

        a.btn {
            align-self: flex-start;
        }
        .texto-opcional {
            display: block;
            color: #b30000; /* rojo suave */
            font-size: 11px; /* pequeño */
            margin-bottom: 6px; /* mantiene espacio con el siguiente campo */
            text-align: left;
            width: 70%;
            padding: 8px;
        }
    </style>
}

<div class="container">
    @if (Model.Rol == "Admin" && Model.AdminData != null)
    {
        <div class="card card-left flex-fill">
            <h3>Top Empleados</h3>
            @if (Model.AdminData.TopEmpleados.Any())
            {
                <ul>
                    @foreach (var e in Model.AdminData.TopEmpleados)
                    {
                        <li>@e</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-center text-muted"><i class="bi bi-exclamation-circle"></i> ¡Sin registros!</p>
            }

            <h3>Lavados hoy por sede</h3>
            @if (Model.AdminData.AutosPorSede.Any())
            {
                <ul>
                    @foreach (var s in Model.AdminData.AutosPorSede)
                    {
                        <li>@s.Key: @(s.Value) Lavados</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-center text-muted"><i class="bi bi-exclamation-circle"></i> ¡Sin registros!</p>
            }
        </div>

        <div class="card card-right flex-fill">
            <h3>Estadísticas del día</h3>
            <ul>
                <li>Autos lavados hoy: @(Model.AdminData.AutosPorSede.Values.Sum())</li>
                <li>Ingresos del día: $@(Model.AdminData.IngresosHoy)</li>
            </ul>

            <div class="charts">
                <div class="chart-box">
                    <canvas id="ingresosChart" height="250"></canvas>
                </div>
            </div>
        </div>
    }
    else if (Model.Rol == "Empleado" && Model.EmpleadoData != null)
    {
        <div class="card card-left flex-fill">
            <h3>Citas asignadas hoy</h3>
            @if (Model.EmpleadoData.CitasAsignadasHoy.Any())
            {
                <ul>
                    @foreach (var c in Model.EmpleadoData.CitasAsignadasHoy)
                    {
                        <li>
                            <b>@c.Cliente</b> - @c.Vehiculo - @c.Servicio (@c.HoraInicio.ToString("HH:mm"))
                        </li>
                    }
                </ul>
                <a href="@Url.Action("GestionarCitas", "Empleado")" class="btn btn-primary mt-2">Ir a Mis Citas</a>
            }
            else
            {
                <p class="text-center text-muted"><i class="bi bi-exclamation-circle"></i> ¡Sin registros!</p>
            }

            <h3 class="mt-4">Citas finalizadas hoy</h3>
            @if (Model.EmpleadoData.CitasFinalizadasHoy.Any())
            {
                <ul>
                    @foreach (var c in Model.EmpleadoData.CitasFinalizadasHoy)
                    {
                        <li>
                            <b>@c.Cliente</b> - @c.Vehiculo - @c.Servicio (@c.HoraInicio.ToString("HH:mm") - @((c.HoraFin.HasValue ? c.HoraFin.Value.ToString("HH:mm") : "--")))
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-center text-muted"><i class="bi bi-exclamation-circle"></i> ¡Sin registros!</p>
            }
        </div>

        <div class="card card-right flex-fill">
            <h3>Historial semanal</h3>
            <canvas id="citasChart" height="250"></canvas>
        </div>
    }
    else if (Model.Rol == "Cliente" && Model.ClienteData != null)
    {
        <div class="card card-left flex-fill">
            <h3>Próxima cita</h3>
            @if (Model.ClienteData.ProximaCita != null)
            {
                <ul>
                    <li><strong>Sede:</strong> @Model.ClienteData.ProximaCita.Sede</li>
                    <li><strong>Servicio:</strong> @Model.ClienteData.ProximaCita.Servicio</li>
                    <li><strong>Hora:</strong> @Model.ClienteData.ProximaCita.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</li>
                    <li><strong>Vehículo:</strong> @Model.ClienteData.ProximaCita.Vehiculo</li>
                </ul>
            }
            else
            {
                <p class="text-center text-muted"><i class="bi bi-exclamation-circle"></i> No tienes citas programadas.</p>
            }

            <h3 class="mt-4">Últimas 3 citas finalizadas</h3>
            @if (Model.ClienteData.UltimasCitas.Any())
            {
                <ul>
                    @foreach (var c in Model.ClienteData.UltimasCitas)
                    {
                        <li>
                            <strong>@c.Sede</strong> - @c.Servicio
                            (<span>@c.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm") -  @c.FechaHoraFin.ToString("HH:mm")</span>)
</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-center text-muted"><i class="bi bi-exclamation-circle"></i> No tienes citas finalizadas aún.</p>
            }

        <div class="text-start">
            <a href="@(hasVehicle ? Url.Action("AgendarCita", "Cliente") : "#")"
               class="btn btn-success mt-2"
               style="max-width: 250px; display:block; margin:0 auto;">Reservar nueva cita</a>

            <a href="@(hasVehicle ? Url.Action("HistorialCitas", "Cliente") : "#")"
               class="btn btn-info mt-2"
               style="max-width: 250px; display:block; margin:0 auto;">Ver historial completo</a>
        </div>
            @if (!hasVehicle){ <small class="texto-opcional">Debes registrar un vehículo para utilizar estos apartados</small> }
        </div>

        <div class="card card-right flex-fill text-center">
            <h3>Sede más cercana</h3>
            @if (!string.IsNullOrEmpty(Model.ClienteData.SedeMasCercana))
            {
                <p><strong>@Model.ClienteData.SedeMasCercana</strong> (a @distanciaFormateada km)</p>
                <div id="map" style="height: 300px; border-radius: 10px;"></div>

                <a href="https://www.google.com/maps?q=@Model.ClienteData.LatitudSede.ToString(System.Globalization.CultureInfo.InvariantCulture),@Model.ClienteData.LongitudSede.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   target="_blank"
                   class="btn btn-outline-primary"
                   style="max-width: 250px; display: block; margin: 15px auto 0 auto;">
                    📍 Ver en Google Maps
                </a>

                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
            }
            else
            {
                <p class="text-center text-muted">
                    <i class="bi bi-exclamation-circle"></i> No se encontró ninguna sede cercana.
                </p>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (Model.Rol == "Admin" && Model.AdminData != null)
        {
            <text>
            var ctx = document.getElementById('ingresosChart').getContext('2d');
            var ingresosChart = new Chart(ctx, {
                type: "line",
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AdminData.DiasUltimos7Dias)),
                    datasets: [{
                        label: "Ingresos",
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AdminData.IngresosUltimos7Dias)),
                        borderColor: "#00cfff",
                        backgroundColor: "rgba(0, 207, 255, 0.2)",
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointBackgroundColor: "#00cfff",
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true },
                        title: {
                            display: true,
                            text: "Ingresos últimos 7 días",
                            color: "#333",
                            font: {
                                size: 18,
                                weight: "bold"
                            },
                            padding: { top: 10, bottom: 20 }
                        }
                    },
                    scales: {
                        x: {
                            title: { display: true, text: "Días" }
                        },
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: "Monto ($)" },
                            ticks: {
                                callback: function (value) {
                                    return "$" + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }
        else if (Model.Rol == "Empleado" && Model.EmpleadoData != null)
        {
            <text>
            var ctxEmpleado = document.getElementById('citasChart').getContext('2d');
            var citasChart = new Chart(ctxEmpleado, {
                type: "line", // puede ser "bar" para barras
                data: {
                    labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EmpleadoData.DiasUltimos7Dias)),
                    datasets: [{
                        label: "Citas finalizadas",
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EmpleadoData.CitasUltimos7Dias)),
                        borderColor: "#007bff",
                        backgroundColor: "rgba(0, 123, 255, 0.2)",
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointBackgroundColor: "#007bff",
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: true },
                        title: {
                            display: true,
                            text: "Historial de citas (últimos 7 días)",
                            color: "#333",
                            font: {
                                size: 18,
                                weight: "bold"
                            },
                            padding: { top: 10, bottom: 20 }
                        }
                    },
                    scales: {
                        x: {
                            title: { display: true, text: "Días" }
                        },
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: "Cantidad de citas" }
                        }
                    }
                }
            });
            </text>
        }
        else if(Model.Rol == "Cliente" && Model.ClienteData != null)
        {
            <text>
            document.addEventListener("DOMContentLoaded", function () {
                var lat = @Model.ClienteData.LatitudSede.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var lon = @Model.ClienteData.LongitudSede.ToString(System.Globalization.CultureInfo.InvariantCulture);

                var map = L.map('map').setView([lat, lon], 15);

                // Capa base de OpenStreetMap
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a>'
                }).addTo(map);

                 // --- Ícono rojo para la sede ---
                var sedeIcon = L.icon({
                    iconUrl: 'https://cdn-icons-png.flaticon.com/512/684/684908.png', // marcador rojo
                    iconSize: [28, 28],
                    iconAnchor: [14, 28],
                    popupAnchor: [0, -25]
                });

                // --- Marcador de la sede (rojo) ---
                var sedeMarker = L.marker([lat, lon], { icon: sedeIcon })
                    .addTo(map)
                    .bindPopup("<b>@Model.ClienteData.SedeMasCercana</b><br>@distanciaFormateada km de distancia");

                // --- Ícono azul para el cliente ---
                var clienteIcon = L.icon({
                    iconUrl: 'https://cdn-icons-png.flaticon.com/512/447/447031.png',
                    iconSize: [28, 28],
                    iconAnchor: [14, 28],
                    popupAnchor: [0, -25]
                });

                // --- Marcador del cliente (azul) ---
                var clienteMarker = L.marker(
                    [
                        @Model.ClienteData.LatitudCliente.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @Model.ClienteData.LongitudCliente.ToString(System.Globalization.CultureInfo.InvariantCulture)
                    ],
                    { icon: clienteIcon }
                ).addTo(map)
                 .bindPopup("<b>Tu ubicación</b>");

                // --- Ajustar el mapa para mostrar ambos ---
                var group = L.featureGroup([sedeMarker, clienteMarker]);
                map.fitBounds(group.getBounds().pad(0.3));

                // Abrir popups iniciales
                clienteMarker.openPopup();
            });
            </text>
        }
    </script>
}
