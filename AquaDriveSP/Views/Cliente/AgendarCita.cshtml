@model AquaDriveSP.ViewModels.AgendarCitaViewModelCliente

@{
    ViewBag.Title = "Agendar Cita";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .empleado-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 30px;
            background: #e6f7ff;
            border-radius: 15px;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.3);
        }

            .empleado-container h2 {
                text-align: center;
                margin-bottom: 25px;
                color: #003366;
            }

        .form-label {
            font-weight: 600;
            color: #003366;
        }

        .btn-confirmar {
            background-color: #00cfff;
            color: white;
            border: none;
            transition: 0.3s;
        }

            .btn-confirmar:hover {
                background-color: #00b5e6;
                color: white;
            }
    </style>
}

<div class="empleado-container">
    <h2>Agendar Nueva Cita</h2>

    <form id="formAgendarCita">
        <div class="mb-3">
            <label for="vehiculo" class="form-label">Seleccionar Vehículo</label>
            <select id="vehiculo" name="vehiculo" class="form-select">
                <option value="0">:: Por seleccionar ::</option>
                @foreach (var v in Model.Vehiculos)
                {
                    <option value="@v.placa">@v.placa</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="sede" class="form-label">Seleccionar Sede</label>
            <select id="sede" name="sede" class="form-select">
                <option value="0">:: Por seleccionar ::</option>
                @foreach (var s in Model.Sedes)
                {
                    <option value="@s.sedeid">@s.nombre</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="tipoServicio" class="form-label">Seleccionar Tipo de Servicio</label>
            <select id="tipoServicio" name="tipoServicio" class="form-select">
                <option value="0">:: Por seleccionar ::</option>
                @foreach (var t in Model.TiposServicios)
                {
                    <option value="@t.tiposervicioid">@t.nombre</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="empleado" class="form-label">Seleccionar Empleado</label>
            <select id="empleado" name="empleado" class="form-select">
                <option value="0">:: Por seleccionar ::</option>
                @foreach (var e in Model.Empleados)
                {
                    <option value="@e.empleadoid">@e.usuario.nombre @e.usuario.apellido</option>
                }
            </select>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="fecha" class="form-label">Fecha</label>
                <input type="date" id="fecha" name="fecha" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label for="hora" class="form-label">Hora</label>
                <input type="time" id="hora" name="hora" class="form-control" step="1800" required />
                <small class="text-danger d-block mt-1">
                    La hora debe seleccionarse en intervalos de 30 minutos.
                </small>
            </div>
        </div>

        <div class="d-flex justify-content-center mt-4">
            <button type="submit" class="btn btn-confirmar px-5 py-2">Confirmar Cita</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/ScriptsViews/Cliente/AgendarCita.js"></script>
}